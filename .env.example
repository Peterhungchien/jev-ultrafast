TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# OpenRouter routes the same System One API to Jev (no TypeSafe account needed).
# Set TYPESAFE_API_KEY to your OpenRouter key (sk-or-v1-...) and uncomment:
#TYPESAFE_BASE_URL=https://openrouter.ai/api
# Official TypeSafe key instead? Clear TYPESAFE_BASE_URL (defaults to api.typesafe.ai).
# Fully local decisions: pip install "laya[serve]" && laya-serve, then
#TYPESAFE_BASE_URL=http://127.0.0.1:8000

# Browser. Default: optional CloakBrowser stealth extra (`uv sync --extra stealth`), headed.
# JEV_BROWSER=chrome -> regular Chrome with instant CDP input.
# JEV_HEADLESS=1 -> headless stealth (much slower with humanize; headed recommended)
# JEV_HUMANIZE=0 -> stealth browser without behavioral humanization
# JEV_PROXY=http://user:pass@residential-proxy:port -> override HTTP(S)_PROXY for browser traffic
# JEV_PROXY= -> force direct browser traffic even when HTTP(S)_PROXY is set
# JEV_GEOIP=1 -> match timezone/locale to the browser proxy exit
# JEV_CDP_PORT=9242 -> DevTools port for the stealth browser
# Parallel processes also need a unique BU_NAME and JEV_CDP_PORT per worker;
# examples/parallel_processes.py assigns both automatically.
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
# Optional same-provider model used only when the primary returns invalid/null text.
#TEXT_MODEL_FALLBACK=
TEXT_MODEL_REASONING=none
